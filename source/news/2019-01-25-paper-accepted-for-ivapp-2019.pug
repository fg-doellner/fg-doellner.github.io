extends /template/newsentry.pug

block newsvariables
  - var newskey = '2019-01-25-paper-accepted-for-ivapp-2019';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper "Rendering Procedural Textures for Visualization of Thematic Data in 3D Geovirtual Environments" by Matthias Trapp, Frank Schlegel, Sebastian Pasewaldt and Jürgen Döllner has been accepted as a contribution to the 10th International Conference on Information Visualization Theory and Applications (IVAPP 2019). The conference will be held in Prague, Czech Republic from the 25th to 27th of January and is part of the VISIGRAPP 2019 conference.
