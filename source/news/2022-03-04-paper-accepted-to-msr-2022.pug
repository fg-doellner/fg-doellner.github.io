extends /template/newsentry.pug

block newsvariables
  - var newskey = '2022-03-04-paper-accepted-to-msr-2022';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p
    | The paper "Tooling for Time- and Space-efficient git Repository Mining" by Fabian Heseding, Willy Scheibel, and Jürgen Döllner was accepted for publication and presentation at the 
    a.external(href="https://conf.researchr.org/home/msr-2022" target="_blank") 2022 Mining Software Repositories Conference
    | . The conference will take place both as virtual and in-person event between May 18-24, 2022.
