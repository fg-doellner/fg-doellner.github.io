block newsvariables
  - var newskey = '2022-05-31-publication-accepted-at-eurocarto-2022';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p
    | The paper entitled "Non-Photorealistic Rendering of 3D Point Clouds for Cartographic Visualization" written by Ole Wegen, Jürgen Döllner, Ronja Wagner, Daniel Limberger, Rico Richter, and Matthias Trapp is accepted for publication in EuroCarto 2022. The conference will be held in Vienna, Austria from September 19-21. For more information, please refer to 
    a(href="https://eurocarto2022.org/" target="_blank") https://eurocarto2022.org/
    | .
