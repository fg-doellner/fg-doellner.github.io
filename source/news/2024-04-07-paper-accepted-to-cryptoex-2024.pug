extends /template/newsentry.pug

block newsvariables
  - var newskey = '2024-04-07-paper-accepted-to-cryptoex-2024';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper "A Low-Volatility Strategy based on Hedging a Quanto Perpetual Swap on BitMEX" authored by Daniel Atzberger, Toshiko Matsui, Robert Henker, Willy Scheibel, Jürgen Döllner, and William Knottenbelt was accepted for publication at the 2nd IEEE International Workshop on Cryptocurrency Exchanges (CryptoEx 2024).
  p The workshop is co-located to the 6th IEEE International Conference on Blockchain and Cryptocurrency (ICBC 2024), which is held from May 27 until May 31 in Dublin, Ireland.
  p
    | Further Information: 
    a.external(href="https://icbc2024.ieee-icbc.org/" target="_blank") ICBC Website
