extends /template/newsentry.pug

block newsvariables
  - var newskey = '2019-01-25-paper-accepted-for-grapp-2019';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper "Generation of Approximate 2D and 3D Floor Plans from 3D Point Clouds" by Vladeta Stojanovic, Matthias Trapp, Rico Richter, and Jürgen Döllner has been accepted as a contribution to the 14th International Conference on Computer Graphics Theory and Applications (GRAPP 2019). The conference will be held in Prague, Czech Republic from the 25th to 27th of January and is part of the VISIGRAPP 2019 conference.
