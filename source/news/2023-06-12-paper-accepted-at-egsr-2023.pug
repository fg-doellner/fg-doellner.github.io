extends /template/newsentry.pug

block newsvariables
  - var newskey = '2023-06-12-paper-accepted-at-egsr-2023';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p
    | The paper "Interactive Control over Temporal Consistency while Stylizing Video Streams" by Sumit Shekhar, Max Reimann, Moritz Hilscher, Amir Semmo, Jürgen Döllner, and Matthias Trapp was accepted for presentation at the34th Eurographics Symposium on Rendering (EGSR 2023). The conference takes place in Delft, Netherlands from June 28th to 30th. The contribution was published in the Journal 
    a.external(href="https://diglib.eg.org/handle/10.1111/cgf14891" target="_blank") "Computer Graphics Forum", Volume 42
    | . The code is available 
    a.external(href="https://maxreimann.github.io/stream-consistency/" target="_blank") here
    | . For more information, 
    a.external(href="https://conferences.eg.org/egsr2023/" target="_blank") visit the website
    | .
