extends /template/newsentry.pug

block newsvariables
  - var newskey = '2023-02-02-invited-paper-published-in-visigrapp-2021';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The publication "Visualization of Source Code Similarity using 2.5D Semantic Software Maps" by Daniel Atzberger, Tim Cech, Willy Scheibel, Daniel Limberger, and Jürgen Döllner was published by Springer in the Book "VISIGRAPP 2021: Computer Vision, Imaging and Computer Graphics Theory and Applications". This paper is an extended version to "Software Forest: A Visualization of Semantic Similarities in Source Code using a Tree Metaphor" that was published at the 12th International Conference on Information Visualization Theory and Applications (IVAPP '21).
