extends /template/newsentry.pug

block newsvariables
  - var newskey = '2012-03-15-contributions-to-the-dgpf-annual-meeting';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p.
    Jan Klimke is presenting a paper entitled "Datenintegration in dienstbasierte 3D-Geovisualisierungssysteme für mobile Geräte" at the DGPF annual meeting.
    
  p
    a.external-link-new-window(href="http://www.hpi.uni-potsdam.de/doellner/publications/year/2012/2053.html" target="_blank" title="Öffnet externen Link in neuem Fenster") Link to the publication.
  p.
    Also, Benjamin Hagedorn gave a Tutorial about "Web-based Visualization of Massive 3D City Models" on March 14 as part of the pre-conference program.
    
  p.
    The DGPF annual meeting is currently held at the Hasso-Plattner-Institut and is also co-organized by our group.
    
  p
    a.external-link-new-window(href="http://www.dgpf.de/neu/jahrestagung/2012.htm" target="_blank" title="Öffnet externen Link in neuem Fenster") Link to the conference.
