extends /template/newsentry.pug

block newsvariables
  - var newskey = '2022-12-27-paper-accepted-to-ivapp-2023';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper "Evaluating Architectures and Hyperparameters of Self-supervised Network Projections" by Tim Cech, Daniel Atzberger, Willy Scheibel, Rico Richter, and Jürgen Döllner was accepted for publication at the 14th International Conference on Information Visualization Theory and Applications (IVAPP '23). The conference will take place in Lisbon, Portugal from February 19th to 21st 2023.
