extends /template/newsentry.pug

block newsvariables
  - var newskey = '2019-07-31-paper-accepted-for-vinci-2019';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper "Advanced Visual Metaphors and Techniques for Software Maps" by Daniel Limberger, Willy Scheibel, Matthias Trapp, and Jürgen Döllner has been accepted for publication at the International Symposium on Visual Information Communication and Interaction (VINCI 2019). The conference will be held in Shanghai, China from 20th to 22nd of September.
  p Links:
  p
    a.external(href="http://www.vinci-conf.org/" target="_blank" title="Conference website") http://www.vinci-conf.org/
