extends /template/newsentry.pug

block newsvariables
  - var newskey = '2024-07-16-paper-accepted-at-ieee-vis-2024';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper entitled "A Large-Scale Sensitivity Analysis on Latent Embeddings and Dimensionality Reductions for Text Spatializations" authored by Daniel Atzberger, Tim Cech, Willy Scheibel, Jürgen Döllner, Michael Behrisch, and Tobias Schreck was selected for publication at the IEEE Conference on Visualization and Visual Analytics (IEEE VIS).
