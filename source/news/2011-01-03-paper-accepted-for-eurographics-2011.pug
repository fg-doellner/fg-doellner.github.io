extends /template/newsentry.pug

block newsvariables
  - var newskey = '2011-01-03-paper-accepted-for-eurographics-2011';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper "Image and Video Abstraction by Coherence-Enhancing Filtering" by Jan Eric Kyprianidis and Henry Kang has been accepted as a contribution to the 32nd annual conference of the European Association for Computer Graphics (Eurographics 2011). The conference will be held from the 12th to 15th April. The 2011 conference will take place in the town of Llandudno in Wales, UK at Venue Cymru.
