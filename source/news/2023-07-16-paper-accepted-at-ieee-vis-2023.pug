extends /template/newsentry.pug

block newsvariables
  - var newskey = '2023-07-16-paper-accepted-at-ieee-vis-2023';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p
    | The full paper "Large-Scale Evaluation of Topic Models and Dimensionality Reductions for 2D Text Spatialization" by Daniel Atzberger, Tim Cech, Matthias Trapp, Rico Richter, Willy Scheibel, Jürgen Döllner, Tobias Schreck was accepted for presentation at the IEEE VIS 2023, the premier forum for advances in visualization and visual analytics. The paper will be published as a special issue of IEEE Transactions on Visualization and Computer Graphics (TVCG). The conference will take place in Melbourne, Australia from October 22nd to 27th. For more information, 
    a.external(href="https://ieeevis.org" target="_blank") visit the website
    | .
