extends /template/newsentry.pug

block newsvariables
  - var newskey = '2023-10-17-best-paper-award-cyberworlds-2023';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p
    | The paper 
    a.external(href="https://maxreimann.github.io/artistic-texture-editing/" target="_blank") Controlling Geometric Abstraction and Texture for Artistic Images
    |  authored by Martin Büßemeyer*, Max Reimann*, Benito Buchheim, Amir Semmo, Jürgen Döllner and Matthias Trapp (*equal contribution) was awarded the best paper award at the 
    a.external(href="https://cw2023.ieee.tn/" target="_blank") International Conference on CyberWorlds 2023
    | .
  p
    br
    | This research was funded by the German Federal Ministry of Education and Research (BMBF) through grant 01IS18092/"mdViPro" and 01IS19006/"KI-LAB-ITSE") and the German Federal Ministry for Economic Affairs and Climate Action (BMWK) (through grant 16KN086401 – “PO-NST”).
