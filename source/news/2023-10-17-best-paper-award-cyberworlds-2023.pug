    li
      a.external(href="https://arxiv.org/pdf/2308.00148.pdf" target="_blank") Link to the arxiv paper
    li
      a.external(href="https://github.com/MartinBuessemeyer/Artistic-Texture-Control" target="_blank") Link to the github code
    li
      a.external(href="https://www.researchgate.net/publication/374663782_Controlling_Geometric_Abstraction_and_Texture_for_Artistic_Images" target="_blank" title="Opens external link in current window") Link to the presentation slides
