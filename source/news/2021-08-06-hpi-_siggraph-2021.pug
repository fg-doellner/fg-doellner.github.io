extends /template/newsentry.pug

block newsvariables
  - var newskey = '2021-08-06-hpi-_siggraph-2021';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The SIGGRAPH 2021 starts next week. We are very honored to present three publications during the Appy Hour:
  ul
    li
      | MotionViz: Artistic Visualization of Human Motion on Mobile Devices (
      a.external(href="https://s2021.siggraph.org/presentation/?id=appy_101&sess=sess175" target="_blank" title="SIGGRAPH - Appy Hour - Session") link to venue
      | )
    li
      | StyleTune: Interactive Style Transfer Enhancement on Mobile Devices (
      a.external(href="https://s2021.siggraph.org/presentation/?id=appy_106&sess=sess175" target="_blank" title="SIGGRAPH - Appy Hour - Session") link to venue
      | )
    li
      | Forward Selfies (
      a.external(href="https://s2021.siggraph.org/presentation/?id=appy_111&sess=sess175" target="_blank" title="SIGGRAPH - Appy Hour - Session") link to venue
      | )
  p
    | We are even more honored to have been featured in the offical SIGGRAPH 
    a.external(href="https://www.youtube.com/watch?v=3AOLMcy4Id0" target="_blank") teaser
    | . We are looking forward to see all the breakthrough research of the worlds biggest computer graphics conference!
