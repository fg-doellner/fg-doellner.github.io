extends /template/newsentry.pug

block newsvariables
  - var newskey = '2019-12-20-paper-accepted-for-ivapp-2020';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper "A Taxonomy of Treemap Visualization Techniques" by Willy Scheibel, Matthias Trapp, Daniel Limberger, and Jürgen Döllner has been accepted as a contribution to the 11th International Conference on Information Visualization Theory and Applications (IVAPP 2020). The conference will be held in Valletta, Malta from the 27th to 29th of February and is part of the VISIGRAPP 2020 conference.
  p Links:
  ul
    li
      a.external(href="http://www.ivapp.visigrapp.org/?y=2020" target="_blank" title="Opens external link in current window") Link to the conference website
