extends /template/newsentry.pug

block newsvariables
  - var newskey = '2019-05-06-paper-accepted-for-iv-2019';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper "Semantic-driven Visualization Techniques for Interactive Exploration of 3D Indoor Models" by Alessandro Florio, Matthias Trapp, and Jürgen Döllner has been accepted as a contribution to the 23rd International Conference Information Visualisation (IV 2019). The conference will be held in Paris, France from the 2nd to 5th of July.
  p Links:
  ul
    li
      a.external(href="http://iv.csites.fct.unl.pt/fr/" target="_blank") Link to the conference website
