extends /template/newsentry.pug

block newsvariables
  - var newskey = '2019-04-21-paper-accepted-to-the-visual-computer';

//-
  block date
    | [date]

  block title
    | [title]

block newscontent
  p.card-text
  p The paper "Locally Controllable Neural Style Transfer on Mobile Devices" by Max Reimann, Mandy Klingbeil, Sebastian Pasewaldt, Amir Semmon, Matthias Trapp, and Jürgen Döllner has been accepted as a journal contribution to "The Visual Computer".
  p Links:
  ul
    li
      a.external(href="http://link.springer.com/article/10.1007/s00371-019-01654-1" target="_blank" title="Opens external link in current window") Link to the article
